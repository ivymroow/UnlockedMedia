NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed in production.
CORS_ORIGINS=https://your-render-app.onrender.com,http://localhost:3000

# Supabase project credentials. Use a service-role key only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Render/free-tier tuning.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
MAX_ACTIVE_STREAMS=8
STREAM_IDLE_MS=600000
STREAM_CLEANUP_INTERVAL_MS=60000
DOWNLOAD_TIMEOUT_MS=480000
DOWNLOAD_RETENTION_MS=900000
FFMPEG_TIMEOUT_MS=30000
